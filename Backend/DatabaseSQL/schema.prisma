generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id                String     @id @default(uuid())
  email             String     @unique
  passwordHash      String
  fullName          String?
  role              UserRole   @default(siswa)
  phone             String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  adminLogs         AdminLog[] @relation("AdminActor")
  verifiedDocuments Document[] @relation("DocumentVerifier")
  student           Student?
  verifiedStudents  Student[]  @relation("StudentVerifier")
}

model Student {
  id                     String                @id @default(uuid())
  userId                 String                @unique
  nisn                   String?
  nik                    String?
  fullName               String
  birthPlace             String?
  birthDate              DateTime?
  gender                 String?
  religion               String?
  address                String?
  rt                     String?
  rw                     String?
  village                String?
  district               String?
  city                   String?
  province               String?
  postalCode             String?
  phone                  String?
  email                  String?
  anakKe                 String?
  jumlahSaudara          String?
  registrationInfoSource String?
  noKip                  String?
  fatherName             String?
  fatherOccupation       String?
  fatherPhone            String?
  motherName             String?
  motherOccupation       String?
  motherPhone            String?
  guardianName           String?
  guardianOccupation     String?
  guardianPhone          String?
  schoolOrigin           String?
  schoolAddress          String?
  graduationYear         String?
  firstChoice            String?
  registrationStatus     RegistrationStatus    @default(draft)
  documentStatus         StudentDocumentStatus @default(pending)
  interviewDate          DateTime?
  interviewNotes         String?
  selectionStatus        SelectionStatus?
  selectionNotes         String?
  acceptedMajor          String?
  submittedAt            DateTime?
  verifiedAt             DateTime?
  verifierId             String?
  createdAt              DateTime              @default(now())
  updatedAt              DateTime              @updatedAt
  documents              Document[]
  user                   Profile               @relation(fields: [userId], references: [id], onDelete: Cascade)
  verifier               Profile?              @relation("StudentVerifier", fields: [verifierId], references: [id])
}

model Document {
  id              String                     @id @default(uuid())
  studentId       String
  documentType    DocumentType
  fileUrl         String
  fileName        String
  fileSize        Int?
  status          DocumentVerificationStatus @default(pending)
  rejectionReason String?
  verifiedAt      DateTime?
  verifiedById    String?
  createdAt       DateTime                   @default(now())
  updatedAt       DateTime                   @updatedAt
  student         Student                    @relation(fields: [studentId], references: [id], onDelete: Cascade)
  verifiedBy      Profile?                   @relation("DocumentVerifier", fields: [verifiedById], references: [id])

  @@unique([studentId, documentType])
}

model AdminLog {
  id          String   @id @default(uuid())
  adminId     String
  action      String
  targetType  String?
  targetId    String?
  detailsJson String?
  ipAddress   String?
  createdAt   DateTime @default(now())
  admin       Profile  @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
}

model SchoolSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  siswa
  admin
  superadmin
}

enum RegistrationStatus {
  draft
  submitted
  verified
  interview_scheduled
  accepted
  rejected
}

enum StudentDocumentStatus {
  pending
  incomplete
  complete
  verified
}

enum DocumentType {
  ktp
  kk
  ijazah
  skhun
  foto
  akta
}

enum DocumentVerificationStatus {
  pending
  verified
  rejected
}

enum SelectionStatus {
  pending
  accepted
  rejected
}
