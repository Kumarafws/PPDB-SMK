{
  "name": "ppdb-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate --schema DatabaseSQL/schema.prisma && tsc",
    "start": "node dist/index.js",
    "db:generate": "prisma generate --schema DatabaseSQL/schema.prisma",
    "db:migrate": "prisma migrate dev --schema DatabaseSQL/schema.prisma",
    "db:push": "prisma db push --schema DatabaseSQL/schema.prisma",
    "db:seed": "tsx DatabaseSQL/seed.ts",
    "db:studio": "prisma studio --schema DatabaseSQL/schema.prisma",
    "test": "cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:unit": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/unit",
    "test:integration": "cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration --runInBand",
    "test:watch": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "test:coverage": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:report-json": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci --json --outputFile=reports/jest-results.json",
    "test:report-human": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci --json --outputFile=reports/jest-results.json && node scripts/format-jest-report.mjs",
    "test:report-format": "node scripts/format-jest-report.mjs",
    "test:report-all": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci --coverage --json --outputFile=reports/jest-results.json",
    "test:save-log": "cross-env NODE_OPTIONS=--experimental-vm-modules jest --ci --no-colors > reports/jest-last-run.txt 2>&1"
  },
  "prisma": {
    "seed": "tsx DatabaseSQL/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.19.1",
    "@types/supertest": "^6.0.2",
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "prisma": "^6.19.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.0",
    "tsx": "^4.21.0",
    "typescript": "^5.7.3"
  }
}
